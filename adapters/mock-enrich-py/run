#!/usr/bin/env python3
"""mock-enrich-py — an external gtm adapter, Python 3 stdlib only.

It exists to prove the adapter boundary is a real process boundary and not a Go
interface in disguise: gtm speaks to this script over stdin/stdout NDJSON exactly
as it speaks to its own built-ins (SPEC §5, §10.7).

Adds `mock.score`, derived deterministically from the identity key so repeated
runs agree, and emits a zero COST so cost accounting is exercised end to end.
"""

import hashlib
import json
import sys

PROVIDES = {
    "type": "object",
    "additionalProperties": False,
    "properties": {
        "mock.score": {"type": "integer", "minimum": 0, "maximum": 100},
        "mock.note": {"type": "string"},
    },
}


def send(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def log(level, text):
    send({"type": "LOG", "level": level, "msg": text})


def score(identity_key):
    """A stable pseudo-random score: seeded from the key, never from the clock."""
    digest = hashlib.sha256(identity_key.encode("utf-8")).digest()
    return digest[0] % 101


def main():
    config = {}
    seen_open = False
    sent_schema = False
    handled = 0

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError as exc:
            print(f"mock-enrich-py: bad input line: {exc}", file=sys.stderr)
            return 1

        kind = msg.get("type")
        if kind == "OPEN":
            seen_open = True
            config = msg.get("config") or {}
            send({"type": "SCHEMA", "provides": PROVIDES})
            sent_schema = True
            continue

        if kind == "RECORD":
            if not sent_schema:
                send({"type": "SCHEMA", "provides": PROVIDES})
                sent_schema = True
            key = msg.get("key") or {}
            identity_key = key.get("identity_key", "")

            # Induced failure, for testing crash-and-resume. Output already sent
            # stays in the ledger because the ledger is append-only.
            if config.get("fail_on") and config["fail_on"] == identity_key:
                print(
                    f"mock-enrich-py: induced failure on {identity_key}",
                    file=sys.stderr,
                )
                return 3

            fields = {"mock.score": score(identity_key)}
            if config.get("note"):
                fields["mock.note"] = config["note"]

            send({"type": "RECORD", "key": key, "fields": fields})
            send(
                {
                    "type": "COST",
                    "key": key,
                    "provider": "mock",
                    "amount_usd": 0,
                    "detail": {"credits": 0},
                }
            )
            handled += 1
            continue

        if kind == "END":
            break
        # Unknown message types are ignored, per the protocol.

    if not seen_open:
        print("mock-enrich-py: stream ended before OPEN", file=sys.stderr)
        return 1

    log("info", f"enriched {handled} records")
    send({"type": "END"})
    return 0


if __name__ == "__main__":
    sys.exit(main())
