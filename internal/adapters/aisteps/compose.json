{
  "id": "ai/compose",
  "version": 1,
  "role": "compose",
  "entity_type": "person",
  "needs": "dynamic",
  "provides": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "first_line": {"type": "string"},
      "ps_line": {"type": "string"}
    }
  },
  "config_schema": {
    "type": "object",
    "required": ["prompt"],
    "additionalProperties": false,
    "properties": {
      "prompt": {"type": "string", "description": "What to write, in the operator's words"},
      "batch_size": {"type": "integer", "minimum": 1},
      "engine": {"type": "string", "enum": ["api", "claude-code"]},
      "model": {"type": "string"},
      "max_tokens": {"type": "integer", "minimum": 256},
      "fields": {
        "type": "array",
        "items": {"type": "string"},
        "description": "Restrict what the model sees to these fields (default: everything known)"
      },
      "provides": {
        "type": "object",
        "description": "The step's derived provides schema (ADR-033). Injected by the runner from the step-level provides: key — never authored inside with:."
      }
    }
  },
  "batch": true,
  "credentials_optional": ["ANTHROPIC_API_KEY"]
}
